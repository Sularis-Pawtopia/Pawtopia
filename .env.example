# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary (Optional - if keeping Cloudinary for images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# DVMF Healthcare + Maya Sandbox
HEALTHCARE_PLATFORM_SERVICE_FEE_PHP=50
NEXT_PUBLIC_HEALTHCARE_PLATFORM_SERVICE_FEE_PHP=50
MAYA_SANDBOX_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_API_KEY=your_maya_sandbox_api_key
MAYA_SECRET_KEY=your_maya_sandbox_secret_key
MAYA_WEBHOOK_SECRET=your_maya_webhook_secret
